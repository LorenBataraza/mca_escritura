%%%%%%%%%%%%%%%%%%%%%%%%%% Estilo de la bibliograf\'{\i}a %%%%%%%%%%%%%%%%%%%%%%
% Esquema: biblatex + biber (reemplaza al natbib + ibtesis.bst originales).
%
% Por qu\'{e} biblatex y no natbib/BibTeX:
%   - refsection=chapter da una bibliograf\'{\i}a por cap\'{\i}tulo "gratis", y una
%     misma clave puede repetirse en varios cap\'{\i}tulos sin conflicto: cada
%     cap\'{\i}tulo la re-numera desde 1 en su propia lista.
%   - soporta localizadores (p\'{a}gina, cap\'{\i}tulo, secci\'{o}n, ecuaci\'{o}n) en la cita:
%     \cite[45]{clave} -> [3, p\'{a}g. 45]
%   - maneja @inbook / @incollection correctamente para capítulos de libro.
%
% Para volver al esquema viejo (ibtesis.bst): comentar todo este bloque,
% descomentar las 3 l\'{\i}neas de natbib del final, y en template.tex cambiar
% \addbibresource{mibib.bib} por \bibliography{mibib}.
\usepackage[
  backend=biber,         % biber, no bibtex (necesario para refsection)
  style=numeric-comp,    % [1], y comprime rangos: [2-5] en vez de [2,3,4,5]
  citestyle=numeric-comp,
  sorting=none,          % la bibliograf\'{\i}a sigue el orden de aparici\'{o}n
  sortcites=true,        % \cite{b,a} imprime [1,2] ordenado
  natbib=true,           % deja vivos \citep, \citet, \citeauthor, \citeyear
  refsection=chapter,    % <-- UNA BIBLIOGRAFIA POR CAPITULO
  backref=true,          % en la bibliograf\'{\i}a, link a la p\'{a}gina que cit\'{o}
  backrefstyle=three,    % comprime "p\'{a}gs. 3, 4, 5" -> "p\'{a}gs. 3-5"
  maxbibnames=10,        % hasta 10 autores antes de usar "et al."
  minbibnames=10,
  maxcitenames=2,        % en el texto, "Autor et al." a partir de 3
  giveninits=true,       % "Bohm, D." en vez de "Bohm, David"
  isbn=false,
  eprint=true,
  doi=true,
]{biblatex}
% URLs largas en la bibliograf\'{\i}a: permitir cortarlas despu\'{e}s de may\'{u}sculas,
% min\'{u}sculas y n\'{u}meros (por default solo corta en / y .).
\setcounter{biburlnumpenalty}{9000}
\setcounter{biburllcpenalty}{7000}
\setcounter{biburlucpenalty}{8000}
% Entradas de la bibliograf\'{\i}a m\'{a}s chicas que el texto: letra \small,
% interlineado simple (el cuerpo usa 1.5) y poco aire entre una entrada y otra.
\renewcommand*{\bibfont}{\small\setstretch{1}}
\setlength{\bibitemsep}{0.35\baselineskip}

% ---- Separadores: [1, p\'{a}g. 45] con coma, al estilo del .bst original ----
\renewcommand*{\postnotedelim}{\addcomma\space}
\renewcommand*{\multicitedelim}{\addcomma}

% ---- Encabezado de la bibliograf\'{\i}a de cada cap\'{\i}tulo ----
% Entra en el \'{\i}ndice como secci\'{o}n del cap\'{\i}tulo, no como cap\'{\i}tulo aparte.
\defbibheading{bibcapitulo}[Referencias]{%
  \section*{#1}%
  \phantomsection%
  \addcontentsline{toc}{section}{#1}%
}

% Se pone al final de cada archivo de cap\'{\i}tulo.
% Uso: \bibliografiacapitulo            -> t\'{\i}tulo "Referencias"
%      \bibliografiacapitulo[Otro t\'{\i}tulo]
\newcommand{\bibliografiacapitulo}[1][Referencias]{%
  \printbibliography[heading=bibcapitulo,title={#1}]%
}

% ---- Atajos para citar con localizador ----
% biblatex ya entiende \cite[45]{clave} y le pone "p\'{a}g." solo.
% Estos atajos son para los casos en que el localizador NO es una p\'{a}gina.
\newcommand{\citepag}[2]{\cite[#2]{#1}}            % \citepag{clave}{45}  o {45-48}
\newcommand{\citecap}[2]{\cite[cap.~#2]{#1}}       % \citecap{libro}{7}
\newcommand{\citesec}[2]{\cite[sec.~#2]{#1}}       % \citesec{libro}{3.2}
\newcommand{\citeec}[2]{\cite[ec.~#2]{#1}}         % \citeec{paper}{12}
\newcommand{\citefig}[2]{\cite[fig.~#2]{#1}}       % \citefig{paper}{4}

