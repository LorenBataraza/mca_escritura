%%%%%%%%%%%%%%%%%%%%%%%%%% Figuras %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Dentro de un figure, toda imagen ocupa el ancho del texto M\'{A}S \desbordefig de
% cada lado (centrada), con la altura que le toque. Con 0mm el borde de la figura
% queda alineado con el del p\'{a}rrafo.
% Un [width=...] expl\'{\i}cito sigue funcionando y tambi\'{e}n queda centrado.
% Fuera de un figure (car\'{a}tula, logos) \includegraphics no cambia.
% En minipages y subfiguras (\linewidth < \textwidth) no desborda.
\newlength{\desbordefig}
\setlength{\desbordefig}{0mm}    % 0mm = figuras al ancho del texto
\setkeys{Gin}{width=\linewidth, height=\alturafig, keepaspectratio}
\LetLtxMacro{\@ibincludegraphics}{\includegraphics}
\NewDocumentCommand{\@ibincludegraphicsancha}{s O{} m}{%
  \ifdim\linewidth=\textwidth
    \makebox[\linewidth][c]{%
      \IfBooleanTF{#1}{\@ibincludegraphics*}{\@ibincludegraphics}%
        [width=\dimexpr\linewidth+2\desbordefig\relax, #2]{#3}}%
  \else
    \IfBooleanTF{#1}{\@ibincludegraphics*}{\@ibincludegraphics}[#2]{#3}%
  \fi}
\AtBeginEnvironment{figure}{\let\includegraphics\@ibincludegraphicsancha}

% Las figuras van justo despu\'{e}s del p\'{a}rrafo que las comenta: en el fuente se
% escriben con \begin{figure}[H] (no flotan; no usar \floatplacement, rompe la
% figuraapaisada). Si no entran, pasan a la p\'{a}gina siguiente y la anterior
% queda corta: \raggedbottom evita que se estire el texto para llenarla.
\raggedbottom

% Ninguna figura sola en una p\'{a}gina. Dos partes:
%  1) tope de altura: imagen + ep\'{\i}grafe tienen que entrar arriba de la p\'{a}gina
%     (\topfraction) dejando lugar para texto. Los dibujos m\'{a}s altos que eso se
%     achican y quedan m\'{a}s angostos;
%  2) LaTeX no arma p\'{a}ginas de solo floats salvo que el float ocupe la p\'{a}gina
%     entera (\floatpagefraction = 0.99999; con 0.99 una figura y una tabla que
%     juntas llenaban la p\'{a}gina quedaban solas): una figura que no entra donde se la
%     llama pasa arriba de la p\'{a}gina siguiente. La \'{u}nica excepci\'{o}n son las
%     figuras apaisadas (figuraapaisada, m\'{a}s abajo), que miden \textheight.
% Al final de un cap\'{\i}tulo (\clearpage) LaTeX igual vuelca lo que haya quedado
% pendiente; el detector de abajo avisa si pasa.
\newcommand{\alturafig}{0.62\textheight}
\renewcommand{\topfraction}{0.85}
\renewcommand{\bottomfraction}{0.6}
\renewcommand{\textfraction}{0.1}
\renewcommand{\floatpagefraction}{0.99999}
\setcounter{topnumber}{2}
\setcounter{bottomnumber}{1}
\setcounter{totalnumber}{3}

% Detector de p\'{a}ginas que quedan solo con floats (sin texto). Cada una deja en
% el log una l\'{\i}nea "PAGINA-SOLO-FLOATS: pag. N". Para listarlas (-a porque el
% log tiene bytes Latin-1 y grep lo tomar\'{\i}a por binario):
%   grep -a PAGINA-SOLO-FLOATS template.log
\newif\if@ibpaginafloats
\pretocmd{\@vtryfc}{\global\@ibpaginafloatstrue}{}{\PackageWarningNoLine{ibextra}{No pude parchear \string\@vtryfc}}
\AddToHook{shipout/before}{%
  \if@ibpaginafloats
    \typeout{PAGINA-SOLO-FLOATS: pag. \thepage\space(fisica \the\numexpr\ReadonlyShipoutCounter+1\relax)%
      \ifcsname @ibrot@\the\numexpr\ReadonlyShipoutCounter+1\relax\endcsname\space apaisada, esperado\fi}%
    \global\@ibpaginafloatsfalse
  \fi}

% Figura apaisada: para las que son mucho m\'{a}s anchas que altas (waveforms).
% Va sola en una p\'{a}gina girada (lo arriba de la figura, hacia el lomo), y el
% PDF muestra esa p\'{a}gina rotada en pantalla. Adentro, \linewidth es el alto de
% la p\'{a}gina. Admite varias im\'{a}genes con su \caption y \label cada una.
%   \begin{figuraapaisada}
%   \includegraphics{a}\caption{...}\label{f:a}
%   \end{figuraapaisada}
% La rotaci\'{o}n en pantalla se resuelve en la segunda pasada (latexmk ya la hace):
% cada figura apaisada anota en el .aux la p\'{a}gina f\'{\i}sica donde sali\'{o}.
% Ojo: en shipout/before \ReadonlyShipoutCounter todav\'{\i}a vale N-1 (p\'{a}ginas ya
% enviadas), de ah\'{\i} los +1.
\newenvironment{figuraapaisada}
  {\begin{sidewaysfigure}\@ibmarcarapaisada\centering
   \captionsetup{width=0.9\linewidth}}
  {\end{sidewaysfigure}}
\newcommand{\@ibmarcarapaisada}{%
  \protected@write\@auxout{}{\string\@ibpaginaapaisada{\noexpand\the\ReadonlyShipoutCounter}}}
\newcommand{\@ibpaginaapaisada}[1]{\global\@namedef{@ibrot@#1}{}}
\newtoks\@ibpageattr
\AtBeginDocument{\@ibpageattr\expandafter{\the\pdfpageattr}}
\AddToHook{shipout/before}{%
  \ifcsname @ibrot@\the\numexpr\ReadonlyShipoutCounter+1\relax\endcsname
    \global\pdfpageattr\expandafter{\the\@ibpageattr /Rotate 90}%
  \else
    \global\pdfpageattr\expandafter{\the\@ibpageattr}%
  \fi}

% Figura que puede no existir todav\'{\i}a (un dibujo de Excalidraw sin export SVG).
% Si existe el PDF la incluye; si no, un recuadro rojo con el nombre del dibujo.
%   \figurapend{figs/cap1/cap1_metodos_recuperacion}{Metodos_recuperacion_Pulso}
\newcommand{\figurapend}[2]{%
  \IfFileExists{#1.pdf}{\includegraphics{#1}}{%
    \fbox{\parbox[c][4cm][c]{0.95\linewidth}{\centering\textcolor{red}{%
      Figura pendiente: falta el SVG de \texttt{\detokenize{#2}}}}}}}

